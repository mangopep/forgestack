{
  "rules": [
    {
      "pattern": "internal/platform/router/**/*.go",
      "area": "API reference (composition root)",
      "doc_path": "docs/generated/API.md",
      "kind": "generated"
    },
    {
      "pattern": "internal/modules/**/*.go",
      "area": "Module business logic (domain/service/endpoint/transport/repository)",
      "doc_path": "docs/generated/API.md",
      "kind": "manual"
    },
    {
      "pattern": "Makefile",
      "area": "Command reference",
      "doc_path": "docs/generated/COMMANDS.md",
      "kind": "generated"
    },
    {
      "pattern": "apps/python-api/**/*.py",
      "area": "Python reference service",
      "doc_path": "apps/python-api/README.md",
      "kind": "manual"
    },
    {
      "pattern": "apps/python-api/**",
      "area": "Cross-language service contract",
      "doc_path": "docs/platform/CONTRACTS.md",
      "kind": "manual"
    },
    {
      "pattern": "internal/platform/middleware/**/*.go",
      "area": "Cross-language service contract",
      "doc_path": "docs/platform/CONTRACTS.md",
      "kind": "manual"
    },
    {
      "pattern": "cmd/**/*.go",
      "area": "Environment variable reference",
      "doc_path": "docs/generated/CONFIG.md",
      "kind": "generated"
    },
    {
      "pattern": "internal/**/*.go",
      "area": "Environment variable reference",
      "doc_path": "docs/generated/CONFIG.md",
      "kind": "generated"
    },
    {
      "pattern": "docs/adr/**",
      "area": "Architecture decision records",
      "doc_path": "docs/adr/",
      "kind": "manual"
    },
    {
      "pattern": "internal/modules/posts/**/*.go",
      "area": "Posts module architecture diagram",
      "doc_path": "docs/architecture/posts-module.md",
      "kind": "manual"
    },
    {
      "pattern": "cmd/**/*.go",
      "area": "Application entrypoint / startup behavior",
      "doc_path": "README.md",
      "kind": "manual"
    },
    {
      "pattern": "databases/**",
      "area": "Database schema",
      "doc_path": "docs/DATABASE.md",
      "kind": "manual"
    },
    {
      "pattern": "infrastructure/terraform/**",
      "area": "Infrastructure (Terraform)",
      "doc_path": "infrastructure/terraform/aws-s3-sandbox/README.md",
      "kind": "manual"
    },
    {
      "pattern": ".github/workflows/**",
      "area": "CI/CD workflows",
      "doc_path": "docs/generated/CI_WORKFLOWS.md",
      "kind": "generated"
    },
    {
      "pattern": ".github/workflows/**",
      "area": "PR validation / publishing flow diagram",
      "doc_path": "docs/architecture/CI-CD-FLOW.md",
      "kind": "manual"
    },
    {
      "pattern": ".golangci.yml",
      "area": "Code review / lint strategy",
      "doc_path": "docs/AUTOMATED-CODE-REVIEW.md",
      "kind": "manual"
    },
    {
      "pattern": "Dockerfile",
      "area": "Container build",
      "doc_path": "README.md",
      "kind": "manual"
    },
    {
      "pattern": "compose.yaml",
      "area": "Local environment",
      "doc_path": "README.md",
      "kind": "manual"
    },
    {
      "pattern": ".github/CODEOWNERS",
      "area": "Review ownership",
      "doc_path": "CONTRIBUTING.md",
      "kind": "manual"
    },
    {
      "pattern": "SECURITY.md",
      "area": "Security policy",
      "doc_path": "SECURITY.md",
      "kind": "manual"
    },
    {
      "pattern": "CLAUDE.md",
      "area": "AI assistant working agreement",
      "doc_path": "CLAUDE.md",
      "kind": "manual"
    },
    {
      "pattern": "website/**/*.js",
      "area": "Documentation website configuration",
      "doc_path": "docs/GITHUB-PAGES-SETUP.md",
      "kind": "manual"
    },
    {
      "pattern": ".github/workflows/pages-deploy.yml",
      "area": "GitHub Pages publishing",
      "doc_path": "docs/GITHUB-PAGES-SETUP.md",
      "kind": "manual"
    },
    {
      "pattern": "internal/branchpolicy/**/*.go",
      "area": "Branch flow policy",
      "doc_path": "docs/handbook/BRANCHING.md",
      "kind": "manual"
    },
    {
      "pattern": "docs/handbook/**",
      "area": "Contributor handbook",
      "doc_path": "docs/handbook/",
      "kind": "manual"
    },
    {
      "pattern": "internal/secreport/**/*.go",
      "area": "Security report generator",
      "doc_path": "docs/security/VULNERABILITY-LIFECYCLE.md",
      "kind": "manual"
    },
    {
      "pattern": "cmd/secreport/**/*.go",
      "area": "Security report generator",
      "doc_path": "docs/security/VULNERABILITY-LIFECYCLE.md",
      "kind": "manual"
    },
    {
      "pattern": "internal/sbomcheck/**/*.go",
      "area": "SBOM validation and augmentation",
      "doc_path": "docs/architecture/SUPPLY-CHAIN-SECURITY.md",
      "kind": "manual"
    },
    {
      "pattern": "cmd/sbomcheck/**/*.go",
      "area": "SBOM validation and augmentation",
      "doc_path": "docs/architecture/SUPPLY-CHAIN-SECURITY.md",
      "kind": "manual"
    },
    {
      "pattern": "docs/security/**",
      "area": "Security and supply-chain documentation",
      "doc_path": "docs/security/",
      "kind": "manual"
    },
    {
      "pattern": "templates/**",
      "area": "Reusable service templates",
      "doc_path": "docs/VERSIONING.md",
      "kind": "manual"
    },
    {
      "pattern": "scripts/new-service.sh",
      "area": "Reusable service templates",
      "doc_path": "docs/VERSIONING.md",
      "kind": "manual"
    },
    {
      "pattern": "internal/semver/**/*.go",
      "area": "Versioning and compatibility",
      "doc_path": "docs/VERSIONING.md",
      "kind": "manual"
    },
    {
      "pattern": ".github/workflows/release.yml",
      "area": "Trusted releases",
      "doc_path": "docs/RELEASES.md",
      "kind": "manual"
    }
  ]
}
